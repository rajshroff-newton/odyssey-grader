# Copy this to .env.local and fill in real values.
# This app has NO client-side Supabase or Anthropic usage at all — every
# variable here is server-only, none are NEXT_PUBLIC_, and none are ever
# sent to the browser.

# Same Supabase project as the main odyssey-eval-task app.
# Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API -> service_role key (NOT the anon key).
# Needed because the anon key has no read access to report_submissions —
# this is the only way for this app to read anything back at all.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
# Optional override; defaults to claude-opus-4-8 if unset.
GRADER_MODEL=claude-opus-4-8
